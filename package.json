{
  "name": "react-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:buyer": "VITE_PORTAL=buyer vite build --outDir dist/buyer",
    "build:seller": "VITE_PORTAL=seller vite build --outDir dist/seller",
    "build:delivery": "VITE_PORTAL=delivery vite build --outDir dist/delivery",
    "build:daily-help": "VITE_PORTAL=professional vite build --outDir dist/daily-help",
    "build:admin": "VITE_PORTAL=admin vite build --outDir dist/admin",
    "build:portals": "bun run build:buyer && bun run build:seller && bun run build:delivery && bun run build:daily-help && bun run build:admin"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
